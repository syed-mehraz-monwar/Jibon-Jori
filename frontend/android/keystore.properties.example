# Template for the release signing configuration.
#
# Copy this file to `keystore.properties` in the same directory
# (frontend/android/keystore.properties) and fill in your own values. That file
# is git-ignored, and so are *.jks / *.keystore, so neither the properties nor
# the keystore can be committed by accident.
#
# Create the keystore once, and keep it somewhere you will not lose it: Android
# identifies an app by its signing key, so losing it means you can never publish
# an update to an already-installed app.
#
#   keytool -genkeypair -v \
#     -keystore D:/keys/jibonjori-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias jibonjori
#
# `storeFile` is resolved relative to frontend/android/, but an absolute path
# (for example D:/keys/jibonjori-release.jks) is equally valid and keeps the
# keystore outside the repository entirely.
#
# With this file present, `npm run build:android:release` produces a SIGNED
# app-release.apk. With it absent, the build still runs but produces an UNSIGNED
# app-release-unsigned.apk that Android will refuse to install.

storeFile=D:/keys/jibonjori-release.jks
storePassword=
keyAlias=jibonjori
keyPassword=
