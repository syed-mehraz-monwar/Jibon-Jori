# JibonJori phone-test environment (Android APK).
#
# Copy this file to `.env.phone.local` (git-ignored) and fill in the Supabase
# project values, or export them in the shell before running
# `npm run build:android`. The build script loads `.env.phone`, then
# `.env.phone.local`, then the plain `.env`, and finally the process environment
# (later wins), so any one of them is enough.
#
# Unlike the earlier LAN-backend setup there is no PC address to substitute: the
# app talks to the hosted Supabase project over HTTPS, so a phone on mobile data
# works exactly as well as one on the same Wi-Fi as the development PC.
#
# These values are baked into the APK's JavaScript bundle at build time, so
# changing them requires rebuilding the APK. Only VITE_-prefixed variables reach
# the bundle, and nothing here may be a secret: this file is public content by
# design. The anon key is a public API key guarded by row level security; the
# service_role key must never be used in a client build.

# Project URL of the Supabase instance, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon (public) API key.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: Google Maps JavaScript API key for the location picker. Leave empty to
# render the explicit "maps not configured" state. Restrict it by HTTP referrer,
# and note that a Capacitor WebView sends an origin of https://localhost.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: YouTube video ids for the learn/watch page, comma separated.
VITE_YOUTUBE_VIDEO_IDS=
