{
  "name": "jibonjori-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deploy": "node test-support/deployment-config.mjs",
    "test:release-gate": "node test-support/release-gate.mjs",
    "test:apk": "node test-support/scan-apk.mjs",
    "test:browser": "node test-support/browser-smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test && npm run test:deploy && npm run test:release-gate && npm run test:apk",
    "build:phone": "npm run typecheck && vite build --mode phone",
    "android:sync": "cap sync android",
    "build:android": "node scripts/build-android.mjs",
    "build:android:release": "node scripts/build-android.mjs --release"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@supabase/supabase-js": "^2.45.0",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@eslint/js": "^9.11.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.10.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "sass": "^1.79.4",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
