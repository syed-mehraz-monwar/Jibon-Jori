# JibonJori frontend environment contract.
#
# Only VITE_-prefixed variables are exposed to the browser bundle, by Vite design.
# Never place a secret here: anything VITE_-prefixed is public.
#
# The browser talks to Supabase directly (PostgREST for REST, pg_graphql for
# GraphQL, Supabase Auth, Storage and Realtime). There is no first-party API
# origin to configure, so the two required values below are all the data layer
# needs.

# Project URL of the Supabase instance, e.g. https://<project-ref>.supabase.co
# The client appends the REST paths itself; no trailing slash is required.
VITE_SUPABASE_URL=

# Supabase anon (public) API key. This is not a secret: it is designed to ship in
# client bundles and is constrained by row level security. The service_role key
# must NEVER be placed here, and must never appear anywhere under frontend/.
VITE_SUPABASE_ANON_KEY=

# Google Maps JavaScript API key, used by the location map and location picker.
# Without it the map components render an explicit "not configured" state rather
# than a broken or fake map. Restrict the key by HTTP referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# YouTube video ids embedded on the learn/watch page, comma separated.
# Defaults to Google's own public demo id when unset.
VITE_YOUTUBE_VIDEO_IDS=
