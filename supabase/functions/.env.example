# =============================================================================
# Edge Function environment - template
# =============================================================================
# Copy to `supabase/.env` (git-ignored) and fill in locally, or set these as
# project secrets for a deployed project:
#
#   npx supabase secrets set --env-file supabase/.env
#
# NEVER commit the filled-in file. Only this template belongs in the repository.
# =============================================================================

# --- provided automatically to every Edge Function -------------------------
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and
# SUPABASE_DB_URL are injected by the platform. Do not set them by hand for a
# deployed project; they are listed here only so it is clear where the functions
# read them from.

# --- LLM provider (ai-chat, ai-explanation) --------------------------------
# OpenAI-compatible chat-completions endpoint. Leave LLM_API_KEY unset and the
# functions degrade to their deterministic fallback instead of failing.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# --- CORS ------------------------------------------------------------------
# Comma-separated exact origins allowed to call the functions from a browser.
# The Capacitor Android origins are always permitted and need not be listed.
# Example: https://jibonjori.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=
